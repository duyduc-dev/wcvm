# Cloudflare Pages / Netlify response headers (copied to the site root by Vite).
#
# wcvm needs a cross-origin isolated page (SharedArrayBuffer), so every response carries COOP + COEP.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# The preview Service Worker registers with scope "/", but its script lives under /assets/, so the
# server has to widen the scope or registration throws a SecurityError and the preview never works.
# (Its file name is hashed, hence the glob.)
/assets/PreviewServiceWorker-*
  Service-Worker-Allowed: /

# The embeddable editor (/embed): any site may frame it. require-corp on an embedder (needed for
# SharedArrayBuffer) refuses to frame a document without CORP, so allow cross-origin.
/embed
  Cross-Origin-Resource-Policy: cross-origin
  Content-Security-Policy: frame-ancestors *
