{
  "name": "wcvm",
  "version": "0.1.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duyduc-dev/webcontainer.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preview-sw": "./dist/workers/preview/PreviewServiceWorker.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "publish:github": "node scripts/publish-github-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "vitest": "^4.1.11"
  }
}
