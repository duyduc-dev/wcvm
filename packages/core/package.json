{
  "name": "wcvm",
  "version": "0.3.0",
  "description": "A WebContainer-style Node.js sandbox that runs entirely in the browser, in Web Workers, with no backend.",
  "keywords": [
    "webcontainer",
    "sandbox",
    "nodejs",
    "browser",
    "web-worker",
    "wasm",
    "in-browser",
    "vite"
  ],
  "license": "ISC",
  "homepage": "https://wcvmjs.com",
  "bugs": {
    "url": "https://github.com/duyduc-dev/wcvm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duyduc-dev/wcvm.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preview-sw": "./dist/workers/preview/PreviewServiceWorker.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_LICENSES.node.txt"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "vitest": "^4.1.11"
  }
}
